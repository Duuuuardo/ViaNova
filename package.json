{
  "name": "vianova",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "jose": "6.2.3",
    "puppeteer-core": "25.3.0",
    "turbo": "2.10.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.28",
    "browserslist": "4.29.3",
    "esbuild": "0.28.2",
    "fast-copy": "4.1.2",
    "js-yaml": "4.3.2",
    "postcss": "8.5.29",
    "postcss>nanoid": "3.3.20",
    "qs": "6.16.0",
    "seroval": "1.6.9",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  }
}
