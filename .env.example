# Banco (docker-compose deste repo expõe na 5434)
VIANOVA_DATABASE_URL=postgres://vianova:vianova_secret@localhost:5434/vianova

# Redis (fila de sync de entitlements — docker-compose deste repo expõe na 6380)
VIANOVA_REDIS_URL=redis://localhost:6380

# URLs
VIANOVA_API_URL=http://localhost:5000
VIANOVA_WEB_URL=http://localhost:3000
VIANOVA_CONFIG_SERVER_URL=http://localhost:5100
# Porta do vite dev server do apps/web (mude junto com VIANOVA_WEB_URL se 3000 estiver ocupada)
# VIANOVA_WEB_PORT=3000

# Segredo para chamadas administrativas internas (ex.: POST /internal/service-token)
INTERNAL_ADMIN_SECRET=change-me-internal-admin

# Stripe (opcional em dev — rotas de billing respondem 503 sem isso)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs do Naia Campaigns (usados no seed de planos)
NAIA_STRIPE_PRICE_FREE=
NAIA_STRIPE_PRICE_STARTER=
NAIA_STRIPE_PRICE_PRO=
NAIA_STRIPE_PRICE_SCALE=

# Stripe Price IDs dos add-ons do Naia Campaigns
NAIA_STRIPE_PRICE_EXTRA_CAMPAIGNS=
NAIA_STRIPE_PRICE_EXTRA_CREDITS=
NAIA_STRIPE_PRICE_EXTRA_SEATS=
NAIA_STRIPE_PRICE_EXTRA_CONNECTIONS=
NAIA_STRIPE_PRICE_EXTRA_AUTOMATIONS=

# SMTP (docker-compose deste repo sobe um Mailpit em localhost:1026, UI em http://localhost:8026)
# Sem SMTP_HOST, emails caem só no console (log [email:dev]).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM="Vianova <no-reply@vianova.software>"

# TOTP
TOTP_ISSUER=Vianova
