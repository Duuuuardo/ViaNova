# Vianova — Variáveis de ambiente de desenvolvimento
#
# Copie este arquivo para .env e preencha os segredos.
# Valores default abaixo são APENAS para dev local (localhost).
# Em produção use senhas fortes e um secrets manager.

# ─── Banco de dados ───
# Postgres do Vianova. docker-compose da raiz expõe na porta 5434.
VIANOVA_DATABASE_URL=postgres://vianova:vianova_secret@localhost:5434/vianova

# ─── Redis ───
# Fila de sync de entitlements e background jobs. docker-compose da raiz expõe na 6380.
VIANOVA_REDIS_URL=redis://:vianova_redis_secret@localhost:6380

# ─── URLs do próprio Vianova ───
VIANOVA_API_URL=http://localhost:5000
VIANOVA_WEB_URL=http://localhost:3000
VIANOVA_ADMIN_URL=http://localhost:3100

# ─── Cookie de sessão ───
# Em produção, define o domínio do cookie para que api.* e app.* compartilhem a sessão.
# Exemplo: VIANOVA_COOKIE_DOMAIN=.vianova.software
# Em dev deixe vazio (o browser restringe ao host exato, ok para localhost).
VIANOVA_COOKIE_DOMAIN=

# ─── Config Server ───
# Endpoint usado pelos apps Vianova para buscar configuração centralizada.
VIANOVA_CONFIG_SERVER_URL=http://localhost:5100

# ─── Segredos internos ───
# Compartilhado entre apps do ecossistema para chamadas service-to-service no Vianova
# (config server, email enqueue, files). Deve bater com VIANOVA_INTERNAL_SECRET
# usado pelos produtos Naia.
VIANOVA_INTERNAL_SECRET=vianova-internal-secret

# Segredo para chamadas administrativas internas (ex.: POST /internal/service-token).
INTERNAL_ADMIN_SECRET=change-me-internal-admin

# Salt para hash de tokens (client secrets, refresh tokens, etc.).
TOKEN_HASH_SALT=change-me-token-hash-salt

# ─── Portas dos dev servers Vite ───
# Só precisam mudar se as portas padrão estiverem ocupadas.
VIANOVA_WEB_PORT=3000
VIANOVA_ADMIN_PORT=3100
VIANOVA_LANDING_PORT=3300

# ─── Variáveis Vite (expõem valores para o browser) ───
# Devem repetir as URLs acima com prefixo VITE_ para que o cliente as enxergue.
VITE_VIANOVA_API_URL=http://localhost:5000
VITE_VIANOVA_WEB_URL=http://localhost:3000

# ─── S3 / MinIO (avatares e arquivos de workspace) ───
# O MinIO do Vianova é exclusivo para avatares e arquivos do hub.
# docker-compose da raiz sobe em localhost:9100 (console :9101).
VIANOVA_S3_ENDPOINT=http://localhost:9100
VIANOVA_S3_ACCESS_KEY=vianova
VIANOVA_S3_SECRET_KEY=vianova_secret
VIANOVA_AVATARS_BUCKET=vianova-avatars
VIANOVA_FILES_BUCKET=vianova-files

# ─── Stripe (opcional em dev — rotas de billing respondem 503 sem isso) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs do Naia Campaigns (usados no seed de planos)
NAIA_STRIPE_PRICE_FREE=
NAIA_STRIPE_PRICE_STARTER=
NAIA_STRIPE_PRICE_PRO=
NAIA_STRIPE_PRICE_SCALE=

# Stripe Price IDs dos add-ons do Naia Campaigns
NAIA_STRIPE_PRICE_EXTRA_CAMPAIGNS=
NAIA_STRIPE_PRICE_EXTRA_CREDITS=
NAIA_STRIPE_PRICE_EXTRA_SEATS=
NAIA_STRIPE_PRICE_EXTRA_CONNECTIONS=
NAIA_STRIPE_PRICE_EXTRA_AUTOMATIONS=
NAIA_STRIPE_PRICE_EXTRA_STORAGE=

# Stripe Price IDs dos add-ons do Naia CRM
CRM_STRIPE_PRICE_EXTRA_AGENTS=
CRM_STRIPE_PRICE_EXTRA_CONNECTIONS=
CRM_STRIPE_PRICE_EXTRA_MANAGERS=
CRM_STRIPE_PRICE_EXTRA_CONVERSATIONS=

# ─── SMTP ───
# docker-compose da raiz sobe um Mailpit em localhost:1026, UI em http://localhost:8026.
# Sem SMTP_HOST, emails caem só no console (log [email:dev]).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vianova <no-reply@vianova.software>"

# ─── TOTP ───
TOTP_ISSUER=Vianova

# ─── Dados para seed do client OIDC "naia" ───
# Usados por packages/db/src/seed.ts para registrar o Naia no Vianova.
NAIA_OIDC_CLIENT_SECRET=naia-dev-secret
NAIA_API_URL=http://localhost:4001
NAIA_WEB_URL=http://localhost:3001

# ─── Rate limiting e CORS (opcionais — têm defaults em código) ───
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
# VIANOVA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3300,http://localhost:3001,http://localhost:3301,http://localhost:3302
# CORS_ALLOWED_ORIGINS=

# ─── Porta de runtime dos serviços (opcional — defaults em código) ───
# PORT=5000          # vianova-api
# PORT=5100          # vianova-config-server
