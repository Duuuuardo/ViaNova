{
  "name": "@vianova/email-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file ../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file ../../.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "5.80.2",
    "ioredis": "5.10.1",
    "nodemailer": "6.10.1"
  },
  "devDependencies": {
    "@vianova/config": "workspace:*",
    "@types/nodemailer": "6.4.17",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
